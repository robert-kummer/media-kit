{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg":        { "$type": "color", "$value": "#0E1013", "$description": "Grundfläche (dunkel)" },
    "bg-deep":   { "$type": "color", "$value": "#08090B", "$description": "Terminal / tiefste Fläche" },
    "surface":   { "$type": "color", "$value": "#15181D", "$description": "Karten, Panels" },
    "border":    { "$type": "color", "$value": "#23272E", "$description": "Section- und Kartenrahmen" },
    "line":      { "$type": "color", "$value": "#2E333B", "$description": "Trennlinien, Timeline" },
    "dashed":    { "$type": "color", "$value": "#4A5059", "$description": "Platzhalter-Rahmen" },
    "text":      { "$type": "color", "$value": "#ECEAE4", "$description": "Primärtext, helle Logo-Variante" },
    "text-2":    { "$type": "color", "$value": "#C9CCD1", "$description": "Fließtext" },
    "text-3":    { "$type": "color", "$value": "#B4B9C1", "$description": "Sekundärtext, Navigation" },
    "muted":     { "$type": "color", "$value": "#9AA0A8", "$description": "Labels, Mono-Meta" },
    "faint":     { "$type": "color", "$value": "#5E646D", "$description": "Trenner, nur dekorativ" },
    "accent":    { "$type": "color", "$value": "#B69963", "$description": "Akzent (Gold) – CTAs, Punkt, Hervorhebung" },
    "on-accent": { "$type": "color", "$value": "#0E1013", "$description": "Text auf Akzentfläche" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"] }
  },
  "radius": {
    "button": { "$type": "dimension", "$value": "8px" },
    "card":   { "$type": "dimension", "$value": "14px" },
    "pill":   { "$type": "dimension", "$value": "999px" }
  }
}
